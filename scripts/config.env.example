# Copy to config.env and edit. Every value here is specific to our two boxes;
# read docs/decisions.md before changing anything that is not a path or a name.

# --- paths (same on both nodes) ---
PYTHON_BIN=$HOME/venvs/qwen/bin/python          # venv with the patched SGLang installed (pip install -e python/)
MODEL_PATH=$HOME/models/Qwen3.8-Flash-Next-NVFP4  # stock NVFP4 checkpoint, no re-quantization
HOT_TOKEN_MAP=$HOME/Balanced-SGLang-Qwen3.8-Flash-Next-NVFP4-Dual-DGX-Spark/hot_tokens_65536.pt   # built by tools/hot_tokens/build_hot_tokens.py
LOG_DIR=$HOME/qwen-logs

# --- nodes ---
WORKER_HOST=spark2                 # ssh alias of rank 1; this script runs on rank 0
MASTER_ADDR=192.168.200.1          # rank 0 address on the direct ConnectX-7 link
MASTER_PORT=20020
API_PORT=8000
SERVED_NAME=qwen3.8-flash-next

# --- RoCE / NCCL (per node: find yours with `ibdev2netdev` and `ip -br link`) ---
MASTER_IB_HCA="rocep1s0f1:1,roceP2p1s0f1:1"
MASTER_IFNAME="enp1s0f1np1,enP2p1s0f1np1"
WORKER_IB_HCA="rocep1s0f0:1,roceP2p1s0f0:1"
WORKER_IFNAME="enp1s0f0np0,enP2p1s0f0np0"

# --- behaviour ---
DROP_CACHES=0     # 1 = sync + drop page cache before start (we used it before PLE reuse existed)
