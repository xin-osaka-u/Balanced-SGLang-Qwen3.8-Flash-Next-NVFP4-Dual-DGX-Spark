# /etc/gpu-governor.env on the master node (rank 0). Values are read at service start.
GOV_ROLE=master
GOV_LISTEN=192.168.200.1:9870
GOV_PEERS=192.168.200.2:9870
GOV_TOKEN=change-me-same-on-both-nodes
GOV_POLL_S=2
GOV_IDLE_AFTER_S=300
GOV_ACTIVE_UTIL_PCT=5
GOV_IDLE_CLOCKS=210,1000
# Empty = full release (-rgc) when active. We run 300,2200 in production: about 4% slower,
# about a third less GPU power under decode (README.md, cap benchmark). Measure before copying.
GOV_ACTIVE_CLOCKS=
# Latch detector: a busy GPU must reach this clock. The power check is off (0) because
# normal decode draws only ~14 W, so a 30 W threshold false-alarmed.
GOV_POWER_OK_W=0
GOV_BUSY_MIN_CLOCK_MHZ=1500
GOV_BUSY_UTIL_PCT=50
GOV_BUSY_SAMPLES=3
GOV_ALARM_REPEAT_S=3600
# Runs on ALARM with the text in $GOV_ALERT_MSG, e.g. a chat webhook post. Leave empty to only log.
GOV_ALERT_CMD=
GOV_LOG_CSV=/var/log/gpu-governor/samples.csv
GOV_CSV_EVERY_S=10
# 1 = observe only, never touch clocks. Start with 1, flip to 0 after step 0 is verified.
GOV_DRY_RUN=1
