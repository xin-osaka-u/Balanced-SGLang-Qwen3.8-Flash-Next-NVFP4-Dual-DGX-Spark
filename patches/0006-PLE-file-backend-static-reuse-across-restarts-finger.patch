diff --git a/python/sglang/srt/models/qwen4_exp_ple_reuse.py b/python/sglang/srt/models/qwen4_exp_ple_reuse.py
new file mode 100644
index 0000000000..7d557d62e9
--- /dev/null
+++ b/python/sglang/srt/models/qwen4_exp_ple_reuse.py
@@ -0,0 +1,248 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Reuse a file-backed Qwen4Exp PLE table across restarts instead of rewriting it.
+
+The native file backend (``--ple-offload-backend file``) keeps the n-gram table
+in a sparse file but rewrites all of it through the weight loader on every
+boot (25.6 GiB per TP rank here). This module adds:
+
+* a **fingerprint sidecar** ``<table>.meta.json`` written only after the table
+  bytes are ``msync``'d and ``fsync``'d (temp file + atomic rename), carrying
+  the checkpoint identity (config / quant-config hashes, the PLE shard files'
+  name+size+mtime), the table geometry, TP size and rank, the SGLang version
+  and a hash of the loader code that produces the table;
+* a **read-only mapping** (``PROT_READ``) when the sidecar matches, so a reuse
+  boot cannot write a single byte to the SSD;
+* a **per-shard content check** on reuse: 32 random 4 KiB windows plus the two
+  ends of each shard are compared against the checkpoint tensor (the same
+  idea as shantanugoel's ``ple_reuse.py``, Apache-2.0). A mismatch aborts the
+  boot with a clear message instead of serving a stale table.
+
+Every rank verifies its own rows against the checkpoint, so two ranks can never
+disagree on content even if one rebuilds while the other reuses.
+
+Env:
+  SGLANG_QWEN4_PLE_REUSE=0           force a rebuild (sidecar is removed first)
+  SGLANG_QWEN4_PLE_REUSE_WINDOWS=N   sampled windows per shard (default 32)
+"""
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import json
+import logging
+import mmap
+import os
+import struct
+import warnings
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+SCHEMA = 1
+_MS_SYNC = 4
+
+
+def reuse_enabled() -> bool:
+    return os.environ.get("SGLANG_QWEN4_PLE_REUSE", "1").strip() != "0"
+
+
+def sidecar_path(table_path: str) -> str:
+    return table_path + ".meta.json"
+
+
+def _sha256_file(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def _ple_checkpoint_files(model_path: str) -> List[List[Any]]:
+    """[name, size, mtime_ns] of every safetensors file holding n-gram shards.
+
+    Only the 8-byte length prefix and the JSON header of each file are read.
+    """
+    out: List[List[Any]] = []
+    try:
+        names = sorted(n for n in os.listdir(model_path) if n.endswith(".safetensors"))
+    except OSError:
+        return out
+    for n in names:
+        p = os.path.join(model_path, n)
+        try:
+            with open(p, "rb") as f:
+                hdr_len = struct.unpack("<Q", f.read(8))[0]
+                hdr = json.loads(f.read(hdr_len))
+        except Exception:  # noqa: BLE001
+            continue
+        if any("ngram_embedding" in k for k in hdr):
+            st = os.stat(p)
+            out.append([n, int(st.st_size), int(st.st_mtime_ns)])
+    return out
+
+
+def compute_fingerprint(
+    *,
+    model_path: Optional[str],
+    shape: Sequence[int],
+    dtype: torch.dtype,
+    tag: Optional[str],
+    tp_size: int,
+    tp_rank: int,
+    loader_sources: Sequence[str],
+    extra: Optional[Dict[str, Any]] = None,
+) -> Dict[str, Any]:
+    fp: Dict[str, Any] = {
+        "schema": SCHEMA,
+        "table": {
+            "shape": [int(d) for d in shape],
+            "dtype": str(dtype).replace("torch.", ""),
+            "tag": tag or "",
+        },
+        "tp_size": int(tp_size),
+        "tp_rank": int(tp_rank),
+    }
+    if model_path and os.path.isdir(model_path):
+        fp["model_path"] = os.path.realpath(model_path)
+        for fn in ("config.json", "hf_quant_config.json"):
+            p = os.path.join(model_path, fn)
+            fp[fn] = _sha256_file(p) if os.path.exists(p) else None
+        fp["ple_files"] = _ple_checkpoint_files(model_path)
+    else:
+        fp["model_path"] = model_path
+    h = hashlib.sha256()
+    for src in loader_sources:
+        try:
+            with open(src, "rb") as f:
+                h.update(f.read())
+        except OSError:
+            h.update(b"missing:" + src.encode())
+    fp["loader_code_sha256"] = h.hexdigest()
+    try:
+        from sglang.version import __version__ as sgl_version
+    except Exception:  # noqa: BLE001
+        sgl_version = "unknown"
+    fp["sglang_version"] = sgl_version
+    if extra:
+        fp["extra"] = extra
+    return fp
+
+
+def read_sidecar(table_path: str) -> Optional[Dict[str, Any]]:
+    p = sidecar_path(table_path)
+    try:
+        with open(p, "r", encoding="utf-8") as f:
+            return json.load(f)
+    except (OSError, ValueError):
+        return None
+
+
+def sidecar_matches(meta: Optional[Dict[str, Any]], fp: Dict[str, Any], table_path: str, nbytes: int) -> Tuple[bool, str]:
+    if meta is None:
+        return False, "no sidecar"
+    if not meta.get("complete"):
+        return False, "sidecar not marked complete"
+    if meta.get("fingerprint") != fp:
+        diff = [k for k in set(meta.get("fingerprint", {})) | set(fp) if meta.get("fingerprint", {}).get(k) != fp.get(k)]
+        return False, f"fingerprint differs in {sorted(diff)}"
+    try:
+        size = os.path.getsize(table_path)
+    except OSError:
+        return False, "table file missing"
+    if size != nbytes:
+        return False, f"table size {size} != {nbytes}"
+    return True, "ok"
+
+
+def map_table(table_path: str, nbytes: int, reuse: bool) -> Tuple[torch.Tensor, Optional[mmap.mmap]]:
+    """Map the table file; read-only when reusing."""
+    if not reuse:
+        if not os.path.exists(table_path) or os.path.getsize(table_path) != nbytes:
+            with open(table_path, "wb") as f:
+                f.truncate(nbytes)  # sparse
+        storage = torch.from_file(table_path, shared=True, size=nbytes, dtype=torch.uint8)
+        return storage, None
+    fd = os.open(table_path, os.O_RDONLY)
+    try:
+        mm = mmap.mmap(fd, nbytes, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ)
+    finally:
+        os.close(fd)  # the mapping keeps its own reference
+    with warnings.catch_warnings():
+        warnings.filterwarnings("ignore", message="The given buffer is not writable")
+        storage = torch.frombuffer(mm, dtype=torch.uint8)
+    return storage, mm
+
+
+def _libc() -> Optional[ctypes.CDLL]:
+    try:
+        return ctypes.CDLL("libc.so.6", use_errno=True)
+    except OSError:
+        return None
+
+
+def finalize_build(storage: torch.Tensor, table_path: str, fp: Dict[str, Any], stats: Dict[str, int]) -> None:
+    """Flush the freshly written table to disk, then publish the sidecar atomically."""
+    libc = _libc()
+    if libc is not None:
+        libc.msync.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int]
+        libc.msync.restype = ctypes.c_int
+        addr = storage.data_ptr()
+        page = mmap.PAGESIZE
+        aligned = addr - (addr % page)
+        length = storage.numel() + (addr - aligned)
+        rc = libc.msync(ctypes.c_void_p(aligned), ctypes.c_size_t(length), _MS_SYNC)
+        if rc != 0:
+            raise OSError(ctypes.get_errno(), "msync of the PLE table failed")
+    fd = os.open(table_path, os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    meta = {"complete": True, "fingerprint": fp, "stats": stats, "written_by": "qwen4_exp_ple_reuse", "schema": SCHEMA}
+    final = sidecar_path(table_path)
+    tmp = final + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(meta, f, indent=1, sort_keys=True)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, final)
+    dfd = os.open(os.path.dirname(final) or ".", os.O_RDONLY)
+    try:
+        os.fsync(dfd)
+    finally:
+        os.close(dfd)
+
+
+def remove_sidecar(table_path: str) -> None:
+    for p in (sidecar_path(table_path), sidecar_path(table_path) + ".tmp"):
+        try:
+            os.remove(p)
+        except FileNotFoundError:
+            pass
+
+
+def shard_matches(dst: torch.Tensor, src: torch.Tensor) -> bool:
+    """True when ``dst`` already holds ``src``, by sampled 4 KiB windows plus both ends."""
+    if dst.shape != src.shape or dst.dtype != src.dtype:
+        return False
+    if dst.numel() == 0:
+        return True
+    a = dst.reshape(-1).view(torch.uint8)
+    b = src.reshape(-1).contiguous().view(torch.uint8)
+    n = int(a.numel())
+    win = 4096
+    if n <= win * 2:
+        return bool(torch.equal(a, b))
+    try:
+        k = max(4, int(os.environ.get("SGLANG_QWEN4_PLE_REUSE_WINDOWS", "32")))
+    except ValueError:
+        k = 32
+    gen = torch.Generator().manual_seed(0x5150 ^ n)
+    offs = (torch.randint(0, (n - win) // win, (k,), generator=gen) * win).tolist()
+    for o in sorted(set(offs + [0, n - win])):
+        if not torch.equal(a[o : o + win], b[o : o + win]):
+            return False
+    return True
