+def pending_ring_slot(
+    requests: torch.Tensor,
+    positions: torch.Tensor,
+    *,
+    compress_ratio: int,
+    num_groups: int = 1,
+) -> torch.Tensor:
+    """Slot of ``positions`` in each request's pending index-K ring.
+
+    A request owns ``compress_ratio * num_groups`` consecutive slots and
+    position ``p`` lands at offset ``p % (compress_ratio * num_groups)``. With
+    ``num_groups == 1`` this is the historical ``req * ratio + p % ratio``.
+    """
