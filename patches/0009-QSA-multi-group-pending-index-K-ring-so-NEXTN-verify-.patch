+    @staticmethod
+    def pending_ring_num_groups(*, max_num_draft_tokens: int, compress_ratio: int) -> int:
+        """Compression groups the per-request pending index-K ring must hold.
+
+        A speculative-paged forward stores every position of its verify window
+        before it compresses any group, and the first group it completes may
+        still need up to ``ratio - 1`` committed members of the open group. The
+        live span is therefore ``(ratio - 1) + draft_tokens`` positions, rounded
+        up to whole groups: one group without speculation, two for a 4-token
+        window, three for 8. ``SGLANG_QSA_RING_GROUPS`` overrides the count
+        (``1`` reproduces the historical single-group layout for A/B runs).
+        """
+        ratio = int(compress_ratio)
+        draft = int(max_num_draft_tokens or 0)
+        groups = 1 if draft <= 1 else -(-(draft + ratio - 1) // ratio)
+        forced = os.environ.get("SGLANG_QSA_RING_GROUPS", "").strip()
+        if forced:
+            try:
+                forced_groups = int(forced)
+            except ValueError as exc:
+                raise ValueError(
+                    f"SGLANG_QSA_RING_GROUPS must be an integer, got {forced!r}"
+                ) from exc
+            if forced_groups < 1:
+                raise ValueError("SGLANG_QSA_RING_GROUPS must be >= 1")
+            if forced_groups < groups:
+                logger.warning(
+                    "SGLANG_QSA_RING_GROUPS=%d is below the %d groups a %d-token "
+                    "verify window needs; verify windows may alias committed keys",
+                    forced_groups, groups, draft,
+                )
+            groups = forced_groups
+        return groups
+
