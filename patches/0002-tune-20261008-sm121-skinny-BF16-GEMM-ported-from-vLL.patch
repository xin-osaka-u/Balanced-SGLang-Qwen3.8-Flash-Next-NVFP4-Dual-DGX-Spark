+def _slice_hot_head(head, hot_token_id, target_lm_head):
+    """Restrict an lm_head weight to the hot tokens, honouring vocab-parallel TP.
+
+    Under TP the target lm_head is sharded along the vocab: ``head`` holds only
+    rows [rank*part, (rank+1)*part). Each rank keeps the hot ids inside its own
+    range as *local* row indices and pads to a common length so the gathered
+    draft logits have equal-width shards. The returned hot_token_id lists the
+    global ids in gathered order (rank blocks in rank order, pads repeating a
+    real id of that block), so ``hot_token_id[topk_index]`` maps back exactly.
+    """
+    hot = hot_token_id.to(device=head.device, dtype=torch.int64)
+    tp_size = getattr(target_lm_head, "tp_size", 1) if target_lm_head is not None else 1
+    shard = getattr(target_lm_head, "shard_indices", None)
+    part = getattr(target_lm_head, "num_embeddings_per_partition", None)
+    if tp_size <= 1 or shard is None or part is None:
+        return head.data[hot], hot
+    rank = shard.org_vocab_start_index // part
+    blocks = []
+    for r in range(tp_size):
+        lo, hi = r * part, (r + 1) * part
+        ids = hot[(hot >= lo) & (hot < hi)]
+        if ids.numel() == 0:
+            ids = torch.tensor([lo], device=hot.device, dtype=torch.int64)
+        blocks.append(ids)
+    width = max(b.numel() for b in blocks)
+    padded = []
+    for b in blocks:
+        if b.numel() < width:
+            b = torch.cat([b, b[-1:].expand(width - b.numel())])
+        padded.append(b)
+    gathered_ids = torch.cat(padded)
+    local_rows = padded[rank] - rank * part
+    logger.info(
+        "hot-token draft head: TP=%d rank=%d keeps %d/%d ids (padded to %d per rank)",
+        tp_size, rank, blocks[rank].numel(), hot.numel(), width,
+    )
+    return head.data[local_rows], gathered_ids
+
+
